function projnm() {
        gcloud projects list | awk '{print $1}' | grep 'ab-cloud-proj' | fzf
}

function projprefix() {
        echo $1 | awk -F '-ab-cloud-proj' '{print $1}'
}

function gosql() {
        local PROJECT=$(projnm)
        local PREFIX=$(projprefix $PROJECT)
	local DBIP=$(gcloud sql instances list --project $PROJECT | fzf | awk '{print $6}')
	local PGPASSWORD=$(gcloud auth application-default print-access-token)
	export PGPASSWORD
        local CMD=(pgcli -u jon@airbyte.io -h $DBIP -d $PREFIX-configapi)
	echo $CMD
	"${CMD[@]}"
}

