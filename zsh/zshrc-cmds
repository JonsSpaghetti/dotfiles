function tag () {
  . tools/bin/workflow/shared/docker.sh
  IMAGE=$(imgnm)
  echo $IMAGE
  tag_image_with_sha "$IMAGE:dev"
}

function get_image_sha() {
    local image=$1
    image_sha=$(docker image inspect $image | jq -r '.[0].Id' | cut -d ':' -f2)
    echo ${image_sha:0:8}
}

function get_image_dev_tag() {
    local image=$1
    local sha=$(get_image_sha $image)
    echo local-${sha}
}

function reabserver() {
 PODNM=$(podnm)
 DESCPOD=$(kubectl describe pod $PODNM)
 IMAGE=$(echo $DESCPOD | grep "Image:" | awk '{print substr($2, 1, index($2, ":") - 1)}')
 IMAGE_WITH_TAG=$(get_image_dev_tag "$IMAGE:dev")
 helm upgrade \
    --install \
    --debug \
    --namespace ab \
    --set server.debug.enabled=true \
    --set server.image.tag=$IMAGE_WITH_TAG \
     ab .
}

function reloadname() {
  echo ":cloud:airbyte-server-wrapped\n:cloud:cloud-server\n:oss:airbyte-server" | fzf
}

function re() {
