function dps (){
	docker-compose ps
}

function dex (){
        servicenm=`servicenm`
	docker-compose exec $servicenm "$@"
}

function servicenm() {
	docker-compose ps --services | fzf
}

function dre() {
	servicenm=`servicenm`
	BASIC_AUTH_USERNAME="" BASIC_AUTH_PASSWORD="" docker-compose restart $servicenm
}

function dup() {
	VERSION=dev BASIC_AUTH_USERNAME="" BASIC_AUTH_PASSWORD="" docker-compose up -d "$@"
}

function dk() {
	servicenm=`servicenm`
	docker-compose kill $servicenm
}

function dd() {
	docker-compose down
}

function dlogs(){
	servicenm=`servicenm`
	docker-compose logs -f $servicenm
}

function podnm() {
	kubectl get pods | sed 's/ .*//' | fzf
}

function deploymentnm() {
	kubectl get deployments | sed 's/ .*//' | fzf
}

function imgnm() {
	docker images | awk '{ print $1 }' | uniq -u | fzf
}

function podnm2() {
	kubectl get pods | sed 's/ .*//' | fzf  --select-1
}

function depnm() {
	kubectl get deployment | sed 's/ .*//' | fzf
}

function plogs() {
	podnm | xargs -t -I {} kubectl logs {} -f
}

function plogsq() {
	podnm | xargs -t -I {} kubectl logs {} -f
